# Copy this file to .env and fill in the values:
# cp .env.example .env

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenHands Configuration
# Get this from https://app.all-hands.dev
OPENHANDS_API_KEY=your_openhands_api_key_here
OPENHANDS_BASE_URL=https://app.all-hands.dev

# GitHub Repository (format: owner/repo)
GITHUB_REPOSITORY=your_github_repo

# Database (optional)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aoms
